# Copy to .env.development.local for pnpm start (default).
# Copy to .env.production.local ONLY for explicitly selected pnpm start:prod.
# Both private files are gitignored. Keep credentials out of tracked files.
# First build assets with pnpm build. Startup serves /doc and /admin on one Node service.
# Startup never creates a database, migrates schemas, or starts Docker.
# DATABASE_URL is read ONLY from the selected private file, never from the shell.
# Replace the host/user/password/database with your PostgreSQL connection details.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/docs_dev
# In .env.production.local, use the database intended for the production instance.
# Explicit migration target; must match the database in DATABASE_URL.
DOCS_DATABASE=docs_dev
# Empty initialization by default; demo is only for disposable development databases.
DOCS_SEED=empty
# Supported URL query options: sslmode, sslrootcert, sslcert, sslkey, application_name.
PORT=4391
DOCS_BIND=127.0.0.1
# Defaults to http://127.0.0.1:4391; set explicitly for a proxy/non-loopback bind.
# DOCS_PUBLIC_ORIGIN=https://docs.example.com
# Optional additional exact origins, comma-separated; no wildcard or paths.
# For LAN development, set the primary origin to the LAN URL and add:
# DOCS_ALLOWED_ORIGINS=http://127.0.0.1:4391,http://localhost:4391
DOCS_ADMIN_USERNAME=admin
DOCS_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
# NODE_ENV never selects the database; only pnpm start:prod enables production.
# Isolated Docker testing is opt-in: pnpm demo:docker / pnpm test:demo:docker.

# Optional administrator MCP endpoint /mcp/admin (Streamable HTTP). Disabled when unset.
# Use an independently generated 32+ character random token; never admin/admin.
# DOCS_MCP_TOKEN=REPLACE_WITH_A_STRONG_RANDOM_TOKEN
